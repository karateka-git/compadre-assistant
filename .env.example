APP_ENV=local
APP_DEBUG=false
# Каналы для привычных scripts и общего healthcheck; например vk для одного VK.
ENABLED_CHANNELS=telegram,vk
# Явный список включённых возможностей; пустая строка отключает все входы.
ENABLED_CAPABILITIES=obsidian
DATABASE_PATH=data/app.db
TELEGRAM_BOT_TOKEN=replace-me
# Необязательный SOCKS5/HTTP-прокси только для Telegram Bot API.
TELEGRAM_PROXY_URL=
VK_BOT_TOKEN=
VK_GROUP_ID=
# Группу LLM заполнить целиком для анализа/review или оставить всю пустой.
# Например https://api.timeweb.ai/v1 и dashscope/qwen3.5-flash.
OPENAI_BASE_URL=
# Ключ LLM независим от embeddings; одинаковые значения задаются явно.
OPENAI_API_KEY=
OPENAI_MODEL=
# Все EMBEDDING_* пусты: FTS fallback без semantic provider.
# Например https://api.timeweb.ai/v1 и openai/text-embedding-3-large.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DOCUMENT_MODEL=
EMBEDDING_QUERY_MODEL=
EMBEDDING_PRICE_PER_MILLION_TOKENS=
EMBEDDING_PRICE_CURRENCY=
EMBEDDING_TARIFF_VERSION=
CHUNK_MINIMUM_SIZE_CHARS=300
CHUNK_TARGET_SIZE_CHARS=3000
CHUNK_MAXIMUM_SIZE_CHARS=6000
# Тег без # для созданных ботом заметок; off отключает маркер.
OBSIDIAN_CREATED_NOTE_TAG=knowledge-catcher
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_PATH=
